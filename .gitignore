.venv/
.env
__pycache__/
*.pyc
.DS_Store

# Raw and processed data — regenerated by the pipeline
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Manual seeds (sample CSVs only — keep .gitkeep, ignore real drops)
data/manual/*
!data/manual/.gitkeep
!data/manual/_sample_*.csv

# Generated outputs (dashboard.html is committed as a template; run.py refreshes it in place)
output/weekly_report.md
